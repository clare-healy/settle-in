{
  "name": "settle-in",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Settle In — a quiet, offline-first yin-class teaching PWA. M1: parse and validate.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsc -p tsconfig.sw.json && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:pwa": "playwright test --config playwright.pwa.config.ts",
    "test:e2e:strict": "playwright test --config playwright.strict.config.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.sw.json",
    "icons": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "idb": "^8.0.3",
    "yaml": "^2.5.1"
  },
  "devDependencies": {
    "@fontsource/hanken-grotesk": "^5.3.0",
    "@fontsource/spectral": "^5.3.0",
    "@playwright/test": "^1.61.1",
    "@types/node": "^20.19.43",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.11.0",
    "typescript": "^5.5.4",
    "vite": "^5.4.2",
    "vitest": "^2.0.5"
  }
}
